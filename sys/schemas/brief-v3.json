{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "video_type": {
      "type": "string",
      "minLength": 1
    },
    "duration": {
      "type": "object",
      "properties": {
        "min_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "min_seconds",
        "max_seconds"
      ],
      "additionalProperties": false
    },
    "scene_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "required_points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "tone": {
      "type": "string",
      "minLength": 1
    },
    "style": {
      "type": "string",
      "minLength": 1
    },
    "aspect_ratio": {
      "enum": [
        "9:16",
        "16:9",
        "dual"
      ]
    },
    "audio_language": {
      "enum": [
        "vi",
        "en"
      ]
    },
    "sound": {
      "type": "object",
      "properties": {
        "bed": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "sfx": {
          "type": "boolean"
        }
      },
      "required": [
        "bed",
        "sfx"
      ],
      "additionalProperties": false
    },
    "facts_required": {
      "type": "boolean"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "title",
          "reference",
          "facts"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "planning": {
      "type": "object",
      "properties": {
        "success_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prior_knowledge": {
          "type": "string",
          "minLength": 1
        },
        "pacing": {
          "type": "string",
          "minLength": 1
        },
        "domain_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "text_style": {
          "type": "object",
          "properties": {
            "font": {
              "type": "string",
              "minLength": 1
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "outline": {
              "type": "string",
              "minLength": 1
            },
            "size": {
              "type": "string",
              "minLength": 1
            },
            "placement": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "font",
            "color",
            "outline",
            "size",
            "placement"
          ],
          "additionalProperties": false
        },
        "speech_rates": {
          "type": "object",
          "properties": {
            "vi": {
              "type": "object",
              "properties": {
                "units_per_second": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "uncertainty": {
                  "type": "number",
                  "minimum": 0.05,
                  "maximum": 0.5
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "includes_pauses": {
                  "type": "boolean"
                }
              },
              "required": [
                "units_per_second",
                "uncertainty",
                "source"
              ],
              "additionalProperties": false
            },
            "en": {
              "type": "object",
              "properties": {
                "units_per_second": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "uncertainty": {
                  "type": "number",
                  "minimum": 0.05,
                  "maximum": 0.5
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "includes_pauses": {
                  "type": "boolean"
                }
              },
              "required": [
                "units_per_second",
                "uncertainty",
                "source"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "vi",
            "en"
          ],
          "additionalProperties": false
        },
        "visual_density": {
          "type": "object",
          "description": "Average seconds of narration per distinct image and per visual beat that every scene must reach (checked on the estimated scene length).",
          "properties": {
            "seconds_per_image": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "seconds_per_beat": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "tolerance": {
              "type": "number",
              "minimum": 1,
              "maximum": 2
            }
          },
          "required": [
            "seconds_per_image",
            "seconds_per_beat"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "success_criteria",
        "avoid",
        "prior_knowledge",
        "pacing",
        "domain_requirements",
        "assumptions",
        "text_style",
        "speech_rates"
      ],
      "additionalProperties": false
    },
    "script_director": {
      "type": "object",
      "description": "Optional bounded semantic critique for horror drafts generated by horror/bank.py.",
      "properties": {
        "enabled": {"type": "boolean"},
        "max_rewrites": {"type": "integer", "minimum": 0, "maximum": 2},
        "min_each": {"type": "integer", "minimum": 0, "maximum": 2},
        "min_total": {"type": "integer", "minimum": 0, "maximum": 12}
      },
      "required": ["enabled", "max_rewrites", "min_each", "min_total"],
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "description": "Voice direction profile (scripts/delivery.py); copied from the channel config.",
      "properties": {
        "voice_director": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "speed_min": {"type": "number", "minimum": 0.8, "maximum": 1.1},
            "speed_max": {"type": "number", "minimum": 0.8, "maximum": 1.1},
            "max_shift": {"type": "number", "minimum": 0, "maximum": 0.15},
            "pause_max": {"type": "number", "minimum": 0, "maximum": 2},
            "scenes_per_call": {"type": "integer", "minimum": 1, "maximum": 6}
          },
          "additionalProperties": false
        },
        "roles": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "priority": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "styles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "speed": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 2
              },
              "sentence": {
                "type": "number",
                "minimum": 0
              },
              "minor": {
                "type": "number",
                "minimum": 0
              },
              "tail": {
                "type": "number",
                "minimum": 0
              },
              "tense": {
                "type": "boolean"
              }
            },
            "required": [
              "speed",
              "sentence",
              "minor",
              "tail"
            ],
            "additionalProperties": false
          }
        },
        "end_tail": {
          "type": "number",
          "minimum": 0
        },
        "moods": {
          "type": "object"
        },
        "mood": {
          "type": "string"
        },
        "lines": {
          "type": "object"
        },
        "fx": {
          "type": "string"
        }
      },
      "required": [
        "roles",
        "priority",
        "styles",
        "lines"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "topic",
    "audience",
    "goal",
    "video_type",
    "duration",
    "scene_count",
    "required_points",
    "language",
    "tone",
    "style",
    "aspect_ratio",
    "facts_required",
    "sources",
    "planning"
  ],
  "additionalProperties": false
}
